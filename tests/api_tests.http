### Health Check
GET http://127.0.0.1:8000/health

### Create Plan
POST http://127.0.0.1:8000/plan
Content-Type: application/json

{
  "source_dir": "storage/videos",
  "output_dir": "storage/salida",
  "ordering": "name",
  "group_size": 3,
  "output_pattern": "Semana{{week|02}}_Dia{{day|02}}.mp4"
}

### Group Videos
POST http://127.0.0.1:8000/group
Content-Type: application/json

{
  "plan": {
    "groups": [
      {
        "index": 1,
        "inputs": [
          "storage/videos/001.mp4",
          "storage/videos/002.mp4",
          "storage/videos/003.mp4"
        ],
        "output": "storage/salida/Semana01_Dia01.mp4"
      },
      {
        "index": 2,
        "inputs": [
          "storage/videos/004.mp4",
          "storage/videos/005.mp4"
        ],
        "output": "storage/salida/Semana01_Dia02.mp4"
      }
    ],
    "total_inputs": 5,
    "total_outputs": 2
  },
  "force": false
}

### Publish to YouTube
POST http://127.0.0.1:8000/publish/youtube
Content-Type: application/json

{
  "outputs": [
    {
      "path": "storage/salida/Semana01_Dia01.mp4",
      "index": 1
    },
    {
      "path": "storage/salida/Semana01_Dia02.mp4",
      "index": 2
    }
  ],
  "slots": {
    "1": "2025-10-13T10:00:00-05:00",
    "2": "2025-10-13T14:00:00-05:00"
  },
  "use_sheets": false,
  "reupload": false
}